# Copy this file to /opt/NovaOpsExecution/apps/api/.env on the VPS.
# Never commit the populated .env file.

DATABASE_URL=postgresql://novaops_user:replace-me@127.0.0.1:5432/novaops_db
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=https://nova-ops.cloud
ENVIRONMENT=production

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

TASK_SCHEDULER_SECRET=replace-with-a-long-random-secret
