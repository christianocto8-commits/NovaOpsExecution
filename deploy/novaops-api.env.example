# Copy these keys into the VPS API environment file.
# Do NOT wrap values in quotes.

ACCESS_TOKEN_EXPIRE_MINUTES=1440
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
BOOTSTRAP_ADMIN_USERNAME=admin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nova-ops.cloud
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=replace-with-long-random-secret
TASK_SCHEDULER_SECRET=replace-with-scheduler-secret

# Optional SMTP (email notifications for checklist failure, overdue, due soon)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=novaops@your-domain.com

# Optional S3 / MinIO evidence storage (fallback: local disk uploads/)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
