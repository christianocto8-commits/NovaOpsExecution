# NovaOps API — VPS Rumahweb (production)
# Copy ke VPS: /opt/NovaOpsExecution/apps/api/.env
#
# Cara pakai di VPS:
#   cd /opt/NovaOpsExecution/apps/api
#   cp /path/to/novaops-vps.env .env
#   nano .env   # isi DATABASE_URL dari Neon + sesuaikan password admin
#
# ATURAN PENTING:
# - Jangan pakai tanda kutip (" atau ') di sekitar nilai
# - DATABASE_URL copy persis dari Neon Dashboard → Connection string → Pooler
# - Hapus parameter channel_binding jika ada (app otomatis strip, tapi lebih aman tanpa)

# --- Wajib ---
DATABASE_URL=GANTI_DENGAN_CONNECTION_STRING_NEON_ANDA

JWT_SECRET_KEY=GANTI_DENGAN_STRING_RANDOM_MINIMAL_32_KARAKTER
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend VPS + local dev (pisahkan dengan koma, tanpa spasi ekstra)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nova-ops.cloud

ENVIRONMENT=production

# --- Admin pertama (auto-created saat API start) ---
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@novaops.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_KUAT_MIN_8_KARAKTER

# --- Task scheduler cron (opsional, untuk recurring task publish) ---
TASK_SCHEDULER_SECRET=GANTI_DENGAN_STRING_RANDOM_SCHEDULER

# --- Alias lama (opsional, tidak wajib jika JWT_* sudah diisi) ---
# SECRET_KEY=sama-dengan-JWT_SECRET_KEY
# ALGORITHM=HS256
