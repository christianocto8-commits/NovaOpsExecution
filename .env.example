# ==========================
# Database
# ==========================

DATABASE_URL=postgresql://novaops_user:novaops_password@localhost:5433/novaops_db

# ==========================
# JWT
# ==========================

SECRET_KEY=change-this-secret

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================
# Frontend
# ==========================

NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_APP_NAME=NovaOps

NEXT_PUBLIC_ENV=development

# ==========================
# Task Scheduler (Render Cron)
# ==========================

TASK_SCHEDULER_SECRET=change-this-scheduler-secret

# ==========================
# Frontend OAuth button
# ==========================

# Set to true when API GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are configured
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# ==========================
# Google OAuth (API — mirror in apps/api/.env)
# ==========================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_FRONTEND_SUCCESS_URL=http://localhost:3000/login/oauth-callback

# ==========================
# Web Push (VAPID) — mirror in apps/api/.env and apps/web/.env.local
# ==========================

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@novaops.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ==========================
# SMS (Twilio) — API only
# ==========================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
