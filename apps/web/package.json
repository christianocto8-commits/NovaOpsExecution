{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "build:mobile": "next build",
    "release:android": "set CAPACITOR_ENV=production&& npm run prepare:capacitor && npx cap sync android",
    "release:android:offline": "node scripts/release-offline-android.mjs",
    "release:android:apk": "npm run release:android && cd android && gradlew assembleRelease",
    "release:android:aab": "npm run release:android && cd android && gradlew bundleRelease",
    "release:mobile:check": "node scripts/check-mobile-release.mjs",
    "release:mobile:qa": "npm run lint && npm run typecheck && npm run build && npm run prepare:capacitor && npm run release:mobile:check",
    "prepare:capacitor": "node scripts/prepare-capacitor.mjs",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test e2e/offline-sync.spec.ts"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.2",
    "@capacitor/network": "^7.0.1",
    "@capacitor/push-notifications": "^7.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@xyflow/react": "^12.11.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/ios": "^7.6.8",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.9.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.12",
    "sharp": "^0.35.0"
  }
}
