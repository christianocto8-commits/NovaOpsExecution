# Copy to .env.local for local development (never commit .env.local)

# API base URL (optional — defaults to same-origin /api proxy)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Web Push (VAPID) — must match VAPID_PUBLIC_KEY in apps/api/.env
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Enterprise OIDC SSO button on login page — see docs/OIDC_SSO_SETUP.md
NEXT_PUBLIC_OIDC_SSO_ENABLED=false

# Enterprise SAML SSO button on login page — see docs/SAML_SSO_ROADMAP.md
NEXT_PUBLIC_SAML_SSO_ENABLED=false

# Google OAuth button on login page (optional)
NEXT_PUBLIC_GOOGLE_SSO_ENABLED=false

# Playwright E2E (optional)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_API_URL=http://localhost:8000
# NOVAOPS_E2E_EMAIL=admin@novaops.com
# NOVAOPS_E2E_PASSWORD=admin123
