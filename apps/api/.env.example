DATABASE_URL=postgresql://novaops_user:novaops_password@localhost:5433/novaops_db
SECRET_KEY=novaops-development-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@novaops.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@novaops.com

# Object storage (optional — leave empty to use local disk uploads/evidence)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Google OAuth (optional MVP SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_FRONTEND_SUCCESS_URL=http://localhost:3000/login/oauth-callback

# Enterprise OIDC SSO (Okta / Azure AD / Keycloak) — see docs/OIDC_SSO_SETUP.md
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
OIDC_FRONTEND_SUCCESS_URL=http://localhost:3000/login/oauth-callback

# Enterprise SAML 2.0 SSO — see docs/SAML_SSO_ROADMAP.md
SAML_SP_ENTITY_ID=http://localhost:8000/api/v1/auth/saml/metadata
SAML_SP_ACS_URL=http://localhost:8000/api/v1/auth/saml/acs
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_METADATA_URL=
SAML_IDP_X509_CERT=
SAML_FRONTEND_SUCCESS_URL=http://localhost:3000/login/oauth-callback

# Firebase Admin (FCM send) — service account JSON path or inline JSON
FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Twilio SMS — see docs/TWILIO_SMS_SETUP.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
